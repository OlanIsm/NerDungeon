# Optional for the M00 placeholder pages. Required when a Supabase helper is used.
# Copy this file to .env.local and use the values from your Supabase project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# NEXT_PUBLIC_* values are bundled into browser code at build time.
# Use an sb_publishable_... key only. Never put a secret/service-role key here.
# M00 does not need any server secrets or AI keys.
