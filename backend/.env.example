# Copy to .env.local. Required to sign in; the public home still works without it.
# Hosted Supabase: HTTPS project URL + sb_publishable_... key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Local Supabase only: if no publishable key is supplied, set the CLI's anon JWT.
# Allowed hosts: localhost, 127.0.0.1, [::1]. The JWT must have role "anon".
# This also supports a local production build; hosted URLs still require HTTPS
# and a publishable key. Leave this blank for hosted deployments.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# NEXT_PUBLIC_* values are bundled into browser code at build time.
# Never put secret/service-role keys here. M01 needs no server secrets or AI keys.
